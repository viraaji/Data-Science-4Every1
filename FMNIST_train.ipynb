    "# Simple MLP (Multi-Layer Perceptron)\n",
    "class SimpleMLP(nn.Module):\n",
    "    def __init__(self, params):\n",
    "        super(SimpleMLP, self).__init__()\n",
    "        self.flatten = nn.Flatten()\n",
    "        self.dropout = nn.Dropout(params['dropout_rate'])\n",
    "        \n",
    "        # Create hidden layers dynamically based on params\n",
    "        layers = []\n",
    "        input_size = 28 * 28  # Input image size\n",
    "        \n",
    "        for i, layer_size in enumerate(params['hidden_layers']):\n",
    "            layers.append(nn.Linear(input_size, layer_size))\n",
    "            \n",
    "            # Apply activation function\n",
    "            if params['activation'] == 'relu':\n",
    "                layers.append(nn.ReLU())\n",
    "            elif params['activation'] == 'leaky_relu':\n",
    "                layers.append(nn.LeakyReLU(0.1))\n",
    "            elif params['activation'] == 'tanh':\n",
    "                layers.append(nn.Tanh())\n",
    "            elif params['activation'] == 'sigmoid':\n",
    "                layers.append(nn.Sigmoid())\n",
    "            elif params['activation'] == 'elu':\n",
    "                layers.append(nn.ELU())\n",
    "                \n",
    "            # Apply dropout\n",
    "            if params['dropout_rate'] > 0:\n",
    "                layers.append(nn.Dropout(params['dropout_rate']))\n",
    "                \n",
    "            # Apply batch normalization if enabled\n",
    "            if params['batch_norm']:\n",
    "                layers.append(nn.BatchNorm1d(layer_size))\n",
    "                \n",
    "            input_size = layer_size\n",
    "        \n",
    "        # Output layer\n",
    "        layers.append(nn.Linear(input_size, 10))\n",
    "        \n",
    "        self.model = nn.Sequential(*layers)\n",
    "        \n",
    "    def forward(self, x):\n",
    "        x = self.flatten(x)\n",
    "        return self.model(x)\n",
    "\n",
    "# CNN (Convolutional Neural Network)\n",
    "class SimpleCNN(nn.Module):\n",
    "    def __init__(self, params):\n",
    "        super(SimpleCNN, self).__init__()\n",
    "        \n",
    "        # First convolutional block\n",
    "        self.conv1 = nn.Conv2d(1, params['filters'][0], kernel_size=params['kernel_size'])\n",
    "        self.bn1 = nn.BatchNorm2d(params['filters'][0]) if params['batch_norm'] else nn.Identity()\n",
    "        \n",
    "        # Second convolutional block\n",
    "        self.conv2 = nn.Conv2d(params['filters'][0], params['filters'][1], kernel_size=params['kernel_size'])\n",
    "        self.bn2 = nn.BatchNorm2d(params['filters'][1]) if params['batch_norm'] else nn.Identity()\n",
    "        \n",
    "        # Calculate output size after convolutions and pooling\n",
    "        conv_output_size = self._get_conv_output_size(params)\n",
    "        \n",
    "        # Fully connected layers\n",
    "        self.fc1 = nn.Linear(conv_output_size, params['fc_units'])\n",
    "        self.fc_bn = nn.BatchNorm1d(params['fc_units']) if params['batch_norm'] else nn.Identity()\n",
    "        self.fc2 = nn.Linear(params['fc_units'], 10)\n",
    "        \n",
    "        # Dropout\n",
    "        self.dropout = nn.Dropout(params['dropout_rate'])\n",
    "        \n",
    "        # Activation function\n",
    "        if params['activation'] == 'relu':\n",
    "            self.activation = nn.ReLU()\n",
    "        elif params['activation'] == 'leaky_relu':\n",
    "            self.activation = nn.LeakyReLU(0.1)\n",
    "        elif params['activation'] == 'tanh':\n",
    "            self.activation = nn.Tanh()\n",
    "        elif params['activation'] == 'sigmoid':\n",
    "            self.activation = nn.Sigmoid()\n",
    "        elif params['activation'] == 'elu':\n",
    "            self.activation = nn.ELU()\n",
    "        \n",
    "        # Pooling layer\n",
    "        if params['pooling'] == 'max':\n",
    "            self.pool = nn.MaxPool2d(2)\n",
    "        elif params['pooling'] == 'avg':\n",
    "            self.pool = nn.AvgPool2d(2)\n",
    "        \n",
    "    def _get_conv_output_size(self, params):\n",
    "        # Helper function to calculate size after convolutions\n",
    "        x = torch.randn(1, 1, 28, 28)\n",
    "        x = self.pool(self.activation(self.conv1(x)))\n",
    "        x = self.pool(self.activation(self.conv2(x)))\n",
    "        return x.numel()\n",
    "    \n",
    "    def forward(self, x):\n",
    "        # Convolutional blocks\n",
    "        x = self.pool(self.activation(self.bn1(self.conv1(x))))\n",
    "        x = self.pool(self.activation(self.bn2(self.conv2(x))))\n",
    "        \n",
    "        # Flatten for fully connected layers\n",
    "        x = x.view(x.size(0), -1)\n",
    "        \n",
    "        # Fully connected layers\n",
    "        x = self.activation(self.fc_bn(self.fc1(x)))\n",
    "        x = self.dropout(x)\n",
    "        x = self.fc2(x)\n",
    "        \n",
    "        return x\n",
    "\n",
    "# More advanced CNN with residual connections\n",
    "class ResidualBlock(nn.Module):\n",
    "    def __init__(self, in_channels, out_channels, stride=1, params=None):\n",
    "        super(ResidualBlock, self).__init__()\n",
    "        self.conv1 = nn.Conv2d(in_channels, out_channels, kernel_size=3, stride=stride, padding=1, bias=False)\n",
    "        self.bn1 = nn.BatchNorm2d(out_channels) if params['batch_norm'] else nn.Identity()\n",
    "        \n",
    "        self.conv2 = nn.Conv2d(out_channels, out_channels, kernel_size=3, stride=1, padding=1, bias=False)\n",
    "        self.bn2 = nn.BatchNorm2d(out_channels) if params['batch_norm'] else nn.Identity()\n",
    "        \n",
    "        self.shortcut = nn.Sequential()\n",
    "        if stride != 1 or in_channels != out_channels:\n",
    "            self.shortcut = nn.Sequential(\n",
    "                nn.Conv2d(in_channels, out_channels, kernel_size=1, stride=stride, bias=False),\n",
    "                nn.BatchNorm2d(out_channels) if params['batch_norm'] else nn.Identity()\n",
    "            )\n",
    "            \n",
    "        # Activation function\n",
    "        if params['activation'] == 'relu':\n",
    "            self.activation = nn.ReLU()\n",
    "        elif params['activation'] == 'leaky_relu':\n",
    "            self.activation = nn.LeakyReLU(0.1)\n",
    "        elif params['activation'] == 'tanh':\n",
    "            self.activation = nn.Tanh()\n",
    "        elif params['activation'] == 'sigmoid':\n",
    "            self.activation = nn.Sigmoid()\n",
    "        elif params['activation'] == 'elu':\n",
    "            self.activation = nn.ELU()\n",
    "        \n",
    "    def forward(self, x):\n",
    "        out = self.activation(self.bn1(self.conv1(x)))\n",
    "        out = self.bn2(self.conv2(out))\n",
    "        out += self.shortcut(x)\n",
    "        out = self.activation(out)\n",
    "        return out\n",
    "\n",
    "class ResNet(nn.Module):\n",
    "    def __init__(self, params):\n",
    "        super(ResNet, self).__init__()\n",
    "        self.in_channels = params['filters'][0]\n",
    "        \n",
    "        self.conv1 = nn.Conv2d(1, self.in_channels, kernel_size=3, stride=1, padding=1, bias=False)\n",
    "        self.bn1 = nn.BatchNorm2d(self.in_channels) if params['batch_norm'] else nn.Identity()\n",
    "        \n",
    "        # Activation function\n",
    "        if params['activation'] == 'relu':\n",
    "            self.activation = nn.ReLU()\n",
    "        elif params['activation'] == 'leaky_relu':\n",
    "            self.activation = nn.LeakyReLU(0.1)\n",
    "        elif params['activation'] == 'tanh':\n",
    "            self.activation = nn.Tanh()\n",
    "        elif params['activation'] == 'sigmoid':\n",
    "            self.activation = nn.Sigmoid()\n",
    "        elif params['activation'] == 'elu':\n",
    "            self.activation = nn.ELU()\n",
    "        \n",
    "        # Residual blocks\n",
    "        self.layer1 = self._make_layer(params['filters'][0], 1, params)\n",
    "        self.layer2 = self._make_layer(params['filters'][1], 1, params)\n",
    "        \n",
    "        # Pooling layer\n",
    "        if params['pooling'] == 'max':\n",
    "            self.pool = nn.MaxPool2d(2)\n",
    "        elif params['pooling'] == 'avg':\n",
    "            self.pool = nn.AvgPool2d(2)\n",
    "            \n",
    "        # Global average pooling\n",
    "        self.avg_pool = nn.AdaptiveAvgPool2d((1, 1))\n",
    "        \n",
    "        # Get the output size\n",
    "        self.fc = nn.Linear(params['filters'][1], 10)\n",
    "        self.dropout = nn.Dropout(params['dropout_rate'])\n",
    "        \n",
    "    def _make_layer(self, out_channels, num_blocks, params):\n",
    "        layers = []\n",
    "        layers.append(ResidualBlock(self.in_channels, out_channels, stride=1, params=params))\n",
    "        self.in_channels = out_channels\n",
    "        for _ in range(1, num_blocks):\n",
    "            layers.append(ResidualBlock(self.in_channels, out_channels, stride=1, params=params))\n",
    "        return nn.Sequential(*layers)\n",
    "    \n",
    "    def forward(self, x):\n",
    "        out = self.activation(self.bn1(self.conv1(x)))\n",
    "        out = self.layer1(out)\n",
    "        out = self.pool(out)\n",
    "        out = self.layer2(out)\n",
    "        out = self.pool(out)\n",
    "        out = self.avg_pool(out)\n",
    "        out = out.view(out.size(0), -1)\n",
    "        out = self.dropout(out)\n",
    "        out = self.fc(out)\n",
    "        return out"
